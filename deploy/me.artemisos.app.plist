<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>me.artemisos.app</string>
    <key>WorkingDirectory</key>
    <string>/Users/artemis/Artemis/artemis-os</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/artemis/Artemis/artemis-os/.venv/bin/uvicorn</string>
        <string>artemis.main:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8000</string>
        <!-- Must exceed cloudflared's proxy-keepalive-timeout (default 90s). At
             uvicorn's 5s default, WE close every idle origin connection, so each
             one lands in TIME_WAIT with local port 8000 — and this box does not
             reap those. They accumulate until a share of new connects to 8000
             stop completing their handshake (app looks "down" while serving
             accepted requests in ~1ms). Closing last keeps TIME_WAIT on
             cloudflared's ephemeral ports instead of piling up on port 8000. -->
        <string>--timeout-keep-alive</string>
        <string>120</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/artemis</string>
        <key>ARTEMIS_CF_ACCESS_ENABLED</key>
        <string>true</string>
        <key>ARTEMIS_CF_ACCESS_TEAM_DOMAIN</key>
        <string>jfila.cloudflareaccess.com</string>
        <key>ARTEMIS_CF_ACCESS_AUD</key>
        <string>196c5861dc5fbe509186be11c6006510050ae562f93a52556d7ef9136042b7d6</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/artemis/Library/Logs/artemisos/app.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/artemis/Library/Logs/artemisos/app.err.log</string>
</dict>
</plist>
