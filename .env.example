# Artemis OS — environment configuration
# Copy to .env and fill in values. Never commit .env.

# Database
ARTEMIS_DB_URL=postgresql+asyncpg://artemis:artemis@localhost:5432/artemis_os

# Auth (v1 shared-account; multi-user schema-ready)
ARTEMIS_TOKEN=
ARTEMIS_CF_ACCESS_ENABLED=false
ARTEMIS_CF_ACCESS_TEAM_DOMAIN=jfila.cloudflareaccess.com
ARTEMIS_CF_ACCESS_AUD=196c5861dc5fbe509186be11c6006510050ae562f93a52556d7ef9136042b7d6
ARTEMIS_GOOGLE_CLIENT_ID=
ARTEMIS_GOOGLE_CLIENT_SECRET=
ARTEMIS_GOOGLE_REDIRECT_URI=https://app.artemisos.me/api/google/oauth/callback

# LLM keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# External APIs (filled in per-scout as we build them)
LEGISCAN_API_KEY=
GRANTS_GOV_API_KEY=
NEWS_API_KEY=
STARBRIDGE_API_KEY=
LINKEDIN_SCRAPER_API_KEY=

# Local dev
ARTEMIS_ENV=development
ARTEMIS_LOG_LEVEL=info
