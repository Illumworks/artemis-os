# Artemis OS — environment configuration
# Copy to .env and fill in values. Never commit .env.

# Database
ARTEMIS_DB_URL=postgresql+asyncpg://artemis:artemis@localhost:5433/artemis_os

# Auth (v1 shared-account; multi-user schema-ready)
ARTEMIS_TOKEN=

# LLM keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# External APIs (filled in per-scout as we build them)
LEGISCAN_API_KEY=
GRANTS_GOV_API_KEY=
NEWS_API_KEY=
STARBRIDGE_API_KEY=
LINKEDIN_SCRAPER_API_KEY=

# Local dev
ARTEMIS_ENV=development
ARTEMIS_LOG_LEVEL=info
